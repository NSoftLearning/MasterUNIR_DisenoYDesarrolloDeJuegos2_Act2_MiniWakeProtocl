  lines:
  - speaker: Jayden
    text: Por fin termina esta pesadilla
    duration: 3
    nameColor: {r: 0.6224805, g: 0.41037738, b: 1, a: 1}
  - speaker: Jayden
    text: "Pero... \xBFque es eso?"
    duration: 3
    nameColor: {r: 0.6224805, g: 0.41037738, b: 1, a: 1}
  - speaker: Jayden
    text: No.... no es posible...
    duration: 3
    nameColor: {r: 0.6224805, g: 0.41037738, b: 1, a: 1}
  - speaker: Jayden
    text: No puede ser... no es posible...  no es posible
    duration: 3
    nameColor: {r: 0.6224805, g: 0.41037738, b: 1, a: 1}
  - speaker: Jayden
    text: No puede ser... no es posible...  no es posible
    duration: 3
    nameColor: {r: 0.6224805, g: 0.41037738, b: 1, a: 1}
  - speaker: Jayden
