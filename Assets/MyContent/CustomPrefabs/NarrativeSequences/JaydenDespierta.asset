  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5e6060832cc94c388f2b6d634a4eb1a5, type: 3}
  m_Name: JaydenDespierta
  m_EditorClassIdentifier: Assembly-CSharp::Modules.NarrativePlayback.API.NarrativeSequence
  lines:
  - speaker: Jayden
    text: "Uf\u2026 Ese fr\xEDo otra vez. Ya podr\xEDan mejorar el despertar de criogenia\u2026"
    duration: 8
    nameColor: {r: 0.6224805, g: 0.41037738, b: 1, a: 1}
  - speaker: Jayden
    text: "\xBFDoctor? Ya estoy despierta"
    duration: 8
    nameColor: {r: 0.6224805, g: 0.41037738, b: 1, a: 1}
  - speaker: Jayden
    text: "\xBFHola? \xBFPuede alguien abrir la c\xE1psula?"
    duration: 8
    nameColor: {r: 0.6224805, g: 0.41037738, b: 1, a: 1}
  - speaker: Jayden
    text: "Siempre hay alguien esperando fuera\u2026 \xBFD\xF3nde se han metido todos?"
    duration: 8
    nameColor: {r: 0.6224805, g: 0.41037738, b: 1, a: 1}
  - speaker: Jayden
    text: "Bueno\u2026 El desbloqueo de emergencia deber\xEDa estar por aqu\xED"
    duration: 8
    nameColor: {r: 0.6224805, g: 0.41037738, b: 1, a: 1}
  - speaker: Jayden
    text: "Vamos\u2026 \xC1brete S\xE9samo"
    duration: 8
    nameColor: {r: 0.6224805, g: 0.41037738, b: 1, a: 1}
  - speaker: Jayden
    text: "Eso es. Despacio\u2026 Todav\xEDa no siento las piernas"
    duration: 8
    nameColor: {r: 0.6224805, g: 0.41037738, b: 1, a: 1}
  - speaker: Jayden
    text: No hay nadie. Esto no es normal
    duration: 8
    nameColor: {r: 0.6224805, g: 0.41037738, b: 1, a: 1}
  blockPlayerControl: 1
